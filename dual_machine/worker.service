[Unit]
Description=fsrcnnx-cudnn dual-machine SR worker
Documentation=https://github.com/Cryspia/dgxspark-jellyfin-mpv-rife
# RoCE interfaces must be up and addressed before NCCL can bind
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spark
Group=spark
WorkingDirectory=/home/spark/dual_machine

# DUAL_WORKER_HOST on the worker is its own address (used as MASTER_ADDR
# is computed via common.py on the host side). The worker discovers its
# own RoCE rails dynamically.
Environment=PYTHONUNBUFFERED=1
# NCCL settings — pull from common.py at start so iface lists track
# whatever rails are actually up. The ExecStartPre script writes them
# into /run/dual_machine/env.sh which we then source.
ExecStartPre=/home/spark/miniforge3/envs/vsmpv/bin/python -c "import sys; sys.path.insert(0, '/home/spark/dual_machine'); import common, os; os.makedirs('/run/dual_machine', exist_ok=True); env=common.nccl_env(common.discover_roce()['rails'][0]['ip']); env.pop('MASTER_ADDR', None); open('/run/dual_machine/env.sh','w').write('\n'.join(f'export {k}={v}' for k,v in env.items()))"

# Start the worker. MASTER_ADDR is provided by the operator (the host's
# RoCE IP) via /etc/default/dual_machine_worker, or defaults below.
EnvironmentFile=-/etc/default/dual_machine_worker
ExecStart=/bin/bash -c 'source /run/dual_machine/env.sh && export MASTER_ADDR=${DUAL_HOST_IP:-10.200.128.1} && export MASTER_PORT=${DUAL_MASTER_PORT:-29500} && export WORLD_SIZE=2 && export RANK=1 && exec /home/spark/miniforge3/envs/vsmpv/bin/python /home/spark/dual_machine/worker.py'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
